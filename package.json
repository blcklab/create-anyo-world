  "description": "Create portable Anyo project repositories for World Loader and Atlas, with editor-ready project metadata and framework-agnostic Web Surface applications.",
  "type": "module",
  "bin": {
    "create-anyo-world": "./bin/create-anyo-world.mjs"
  },
  "files": [
